# systemd service for Linux servers.
# Copy to /etc/systemd/system/fvt.service, adjust the paths and user, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now fvt
#   sudo journalctl -u fvt -f        (to read the logs)

[Unit]
Description=Field Visit Tracker
After=network.target postgresql.service

[Service]
Type=simple
User=fvt
WorkingDirectory=/opt/field-visit-tracker/api
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
