// Database tables for the Field Visit Tracker.
//
// People, units, offices and settings are normal tables. A visit is stored as one
// JSON document (column `data`) holding its route, stays and every entry
// (action items, client interactions, observations, stories) exactly as the
// screens use it, with a few columns copied out of it for searching.
// Adding a new field to an entry form therefore needs no database change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Staff who use the staff app: base users ("field"), fixers and management.
model Employee {
  id           String   @id
  name         String
  phone        String?
  email        String?  // where action item emails go when this person is a fixer
  pin          String   @unique
  passwordHash String
  roles        String[] // "field" | "fixer" | "management"
  departmentId String?  // the person's unit (Department), e.g. Software; a fixer's queue is this unit's
  teamId       String?  // their team (a Unit row) inside that unit, e.g. IT Support; optional
  supervisorId String?
  designation  String?
  department   String?  // the staff department (Microfinance, HR, ...), used by the Summary filter
  title        String?
  createdAt    DateTime @default(now())
}

// People who sign in to the admin console.
model AdminUser {
  id           String   @id
  name         String
  email        String?
  pin          String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// A "Unit" on screen (e.g. Software). Its teams are the Unit rows below.
model Department {
  id        String @id
  name      String
  sortOrder Int    @default(0)
  units     Unit[]
}

// A "Team" on screen (e.g. IT Support), inside a Department.
model Unit {
  id           String     @id
  name         String
  sortOrder    Int        @default(0)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

// ---- Where things are: Division → Region → Area → Branch ----
// All of it comes from BRAC's branch API (api/src/locations): the API's rows are kept as they
// arrive in ApiBranchRow, and each sync rebuilds Region, Area and Office from them. Divisions,
// regions and areas are BRAC's own (all programmes together, merged by name); nobody edits them here.

model Region {
  id        String  @id
  name      String
  division  String // e.g. "North East"
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  areas     Area[]

  @@unique([division, name])
}

model Area {
  id        String  @id
  name      String
  regionId  String
  region    Region  @relation(fields: [regionId], references: [id], onDelete: Restrict)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  @@unique([regionId, name])
}

// Every office, by type:
//   "region" = Regional Office: one per region (placed in a Division)
//   "area"   = Area Office:     one per area (placed in a Region, and so its Division)
//   "branch" = Branch Office:   one per BRAC branch ID, placed in every Area its programmes put it in
// division / region / area hold the first placement; `placements` holds all of them
// ([{ division, region, area, programmes }]). Visits refer to offices by id.
// An office the API no longer lists is switched off (active = false), never deleted.
model Office {
  id         String  @id
  name       String
  type       String  @default("branch")
  code       String? // a branch's BRAC branch ID ("2853", or "2853.1" for the second office sharing it)
  division   String?
  region     String?
  area       String?
  placements Json?
  lat        Float?
  lng        Float?
  active     Boolean @default(true)
  sortOrder  Int     @default(0)
}

// One row of BRAC's branch API, exactly as it arrived. A branch is listed once per programme,
// so the key is "<programme>:<branch_id>" ("none:<br_id>" for the rows without a programme).
// `present` is false once a sync no longer finds the row.
model ApiBranchRow {
  key         String   @id
  branchId    String
  programName String?
  data        Json
  hash        String
  present     Boolean  @default(true)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([branchId])
}

// Each time the locations were synced or rebuilt, and what came of it.
model LocationSync {
  id         String    @id
  trigger    String // "nightly" | "manual" | "file" | "rules"
  status     String    @default("running") // "running" | "ok" | "failed" | "refused"
  message    String?
  report     Json?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([startedAt])
}

model Visit {
  id         String   @id
  employeeId String
  status     String   @default("open") // "open" | "done"
  date       String? // visiting date, YYYY-MM-DD
  data       Json // the whole visit document
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([date])
}

// Key/value settings. "app" holds what every screen reads (visit target, rating
// questions, management tabs). "smtp" holds the mail server and is never sent
// to the browser with its password.
model Setting {
  key   String @id
  value Json
}

// Every email the system sends (or tried to send).
model EmailLog {
  id          String   @id
  complaintId String?
  to          String
  toName      String?
  type        String
  subject     String
  body        String
  status      String   @default("sent") // "sent" | "failed" | "not-sent"
  error       String?
  sentAt      DateTime @default(now())

  @@index([sentAt])
}
