// Database tables for the Field Visit Tracker.
//
// People, units, offices and settings are normal tables. A visit is stored as one
// JSON document (column `data`) holding its route, stays and every entry
// (action items, client interactions, observations, stories) exactly as the
// screens use it, with a few columns copied out of it for searching.
// Adding a new field to an entry form therefore needs no database change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Staff who use the staff app: base users ("field"), fixers and management.
model Employee {
  id           String   @id
  name         String
  phone        String?
  email        String?  // where action item emails go when this person is a fixer
  pin          String   @unique
  passwordHash String
  roles        String[] // "field" | "fixer" | "management"
  departmentId String?  // the person's unit (Department), e.g. Software; a fixer's queue is this unit's
  teamId       String?  // their team (a Unit row) inside that unit, e.g. IT Support; optional
  supervisorId String?
  designation  String?
  department   String?  // the staff department (Microfinance, HR, ...), used by the Summary filter
  title        String?
  createdAt    DateTime @default(now())
}

// People who sign in to the admin console.
model AdminUser {
  id           String   @id
  name         String
  email        String?
  pin          String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// A "Unit" on screen (e.g. Software). Its teams are the Unit rows below.
model Department {
  id        String @id
  name      String
  sortOrder Int    @default(0)
  units     Unit[]
}

// A "Team" on screen (e.g. IT Support), inside a Department.
model Unit {
  id           String     @id
  name         String
  sortOrder    Int        @default(0)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

// ---- Where things are: Division → Region → Area → Branch (BRAC's own structure) ----
// Most rows come from BRAC's ERP branch list (source "erp", see api/src/branch-sync): they are
// read-only in the admin console and kept up to date by the daily sync. The admin can add more
// by hand (source "admin"). A row the ERP no longer lists is kept but switched off (active false),
// so past visits still find it while new visits can't choose it.
// externalId = the ERP's id (division_id, region_id, area_id, branch_id); erpCode = DO…/RO…/AO… codes.

model Division {
  id         String  @id
  name       String  @unique // e.g. "North East"
  externalId String? @unique
  erpCode    String?
  source     String  @default("admin")
  active     Boolean @default(true)
  sortOrder  Int     @default(0)
}

model Region {
  id         String  @id
  name       String  @unique
  division   String // the Division's name
  externalId String? @unique
  erpCode    String?
  source     String  @default("admin")
  active     Boolean @default(true)
  sortOrder  Int     @default(0)
  areas      Area[]
}

model Area {
  id         String  @id
  name       String
  externalId String? @unique
  erpCode    String?
  source     String  @default("admin")
  regionId   String
  region    Region  @relation(fields: [regionId], references: [id], onDelete: Restrict)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  @@unique([regionId, name])
}

// Every office, by type:
//   "region" = Regional Office: placed in a Division
//   "area"   = Area Office:     placed in a Region (and so its Division)
//   "branch" = Branch Office:   placed in an Area (and so its Region and Division)
// The place is stored by name, as visits store it.
model Office {
  id        String  @id
  name      String
  type      String  @default("branch")
  division  String?
  region    String?
  area      String?
  lat       Float?
  lng       Float?
  active    Boolean @default(true)
  externalId      String? @unique // branch_id, or "RO:<region_id>" / "AO:<area_id>" for regional / area offices
  erpCode         String?
  source          String  @default("admin")
  sourceUpdatedAt String? // the ERP's updated_at for this branch, e.g. "2025-11-12 23:20:12"
  sortOrder Int     @default(0)
}

model Visit {
  id         String   @id
  employeeId String
  status     String   @default("open") // "open" | "done"
  date       String? // visiting date, YYYY-MM-DD
  data       Json // the whole visit document
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([date])
}

// Key/value settings. "app" holds what every screen reads (visit target, rating
// questions, management tabs). "smtp" holds the mail server and is never sent
// to the browser with its password.
model Setting {
  key   String @id
  value Json
}

// Every email the system sends (or tried to send).
model EmailLog {
  id          String   @id
  complaintId String?
  to          String
  toName      String?
  type        String
  subject     String
  body        String
  status      String   @default("sent") // "sent" | "failed" | "not-sent"
  error       String?
  sentAt      DateTime @default(now())

  @@index([sentAt])
}
