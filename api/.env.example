# ---- Field Visit Tracker API settings (copy to .env and fill in) ----

# PostgreSQL connection
DATABASE_URL="postgresql://fvt:CHANGE_ME@localhost:5432/fvt?schema=public"

# A long random string. Signs the sign-in cookies and encrypts the SMTP password.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Port the app listens on (put Nginx/IIS in front of it for HTTPS)
PORT=4000

# The address people open, used in email links (no trailing slash)
APP_URL="https://fieldvisit.brac.net"

# BRAC's ERP branch list: synced every day at 2:00 AM into the app's own tables
BRAC_BRANCH_API_URL="https://trendxstage.brac.net/api/branch/allbranchlist"
BRAC_BRANCH_API_TOKEN=""

# The first admin account, created by "npm run db:seed" if no admin exists yet
SEED_ADMIN_NAME="System Admin"
SEED_ADMIN_PIN="9001"
SEED_ADMIN_PASSWORD="CHANGE_ME"

# Optional: where uploaded voice notes are kept (default: api/uploads)
# UPLOAD_DIR="/var/lib/fvt/uploads"
